# 모니터링 결과를 저장하는 Supabase 프로젝트. 서비스 롤 키를 사용하므로 서버에서만 노출한다.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# 크론이 POST /api/monitor를 호출할 때 쓰는 Bearer 토큰.
CRON_SECRET=

# 브라우저에서 POST /api/monitor/:apiId를 호출할 수 있는 오리진 목록. 쉼표로 구분한다.
# monitor-web의 로컬 dev 서버는 3000번 포트를 쓰고, 배포 주소는 https://status.finditem.kr 이다.
# 예: http://localhost:3000,https://status.finditem.kr
# 목록에 없는 오리진에는 CORS 헤더를 내려주지 않아 브라우저가 응답을 차단한다.
MONITOR_WEB_ORIGINS=

# 점검 대상 API 호출에 필요한 인증 값. 해당 제공사의 API를 등록하지 않았다면 비워둬도 된다.
# KAKAO_REST_API_KEY는 dapi.kakao.com REST API의 Authorization 헤더와 kauth.kakao.com OAuth authorize의 client_id에 사용한다.
KAKAO_REST_API_KEY=
# KAKAO_JAVASCRIPT_KEY는 Kakao Maps SDK 호출의 appkey 쿼리에 사용한다.
KAKAO_JAVASCRIPT_KEY=
# KAKAO_REDIRECT_URI는 Kakao OAuth authorize 호출의 redirect_uri 쿼리에 사용한다.
KAKAO_REDIRECT_URI=
# VWORLD_API_KEY는 api.vworld.kr 호출의 key 쿼리에 사용한다.
VWORLD_API_KEY=
