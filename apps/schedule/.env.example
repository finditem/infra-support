NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Slack 알림 (일정 생성/수정/삭제). 값이 없으면 알림만 건너뛰고 일정 저장은 정상 동작한다.
# SLACK_BOT_TOKEN: Flow_Bot 앱의 Bot User OAuth Token (xoxb-로 시작). 서버 전용이므로 NEXT_PUBLIC_ 접두사를 붙이지 않는다.
# SLACK_CHANNEL_ID: 알림을 올릴 팀 채널 ID (C로 시작)
# SITE_URL: 알림 메시지의 "바로 보기" 링크에 사용할 배포 주소 (예: https://schedule.example.com)
SLACK_BOT_TOKEN=
SLACK_CHANNEL_ID=
SITE_URL=
