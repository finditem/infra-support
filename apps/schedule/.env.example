NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Slack 알림 (일정 생성/수정/삭제). 값이 없으면 알림만 건너뛰고 일정 저장은 정상 동작한다.
# SLACK_BOT_TOKEN: Flow_Bot 앱의 Bot User OAuth Token (xoxb-로 시작). 서버 전용이므로 NEXT_PUBLIC_ 접두사를 붙이지 않는다.
# SLACK_CHANNEL_ID: 알림을 올릴 팀 채널 ID (C로 시작)
# SITE_URL: 알림 메시지의 "바로 보기" 링크에 사용할 배포 주소 (예: https://schedule.example.com)
SLACK_BOT_TOKEN=
SLACK_CHANNEL_ID=
SITE_URL=

# 슬랙 봇 인바운드 연동 (DM 명령 처리, 리마인드, 주간 리포트). 모두 서버 전용이므로 NEXT_PUBLIC_ 접두사를 붙이지 않는다.
# SUPABASE_SERVICE_ROLE_KEY: 로그인 세션이 없는 Slack 웹훅/cron 라우트에서 RLS를 우회해 접근할 때 사용 (src/lib/supabase/service.ts). 절대 클라이언트 번들에 노출하지 않는다.
# SLACK_SIGNING_SECRET: Slack이 보낸 요청(Events API, Interactivity)의 서명을 검증하는 값. Slack App 설정 > Basic Information에서 확인
# OPENAI_API_KEY: 자연어 일정 등록(5-2) 파싱에 쓰는 OpenAI API 키
# CRON_SECRET: Vercel Cron이 호출하는 /api/cron/* 라우트 인증에 쓰는 임의의 비밀값
SUPABASE_SERVICE_ROLE_KEY=
SLACK_SIGNING_SECRET=
OPENAI_API_KEY=
CRON_SECRET=
