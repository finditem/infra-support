VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# monitor-server 주소. 수동 점검 요청(POST /api/monitor/:apiId)에 사용한다.
# 로컬에서는 monitor-server의 dev 서버 주소인 http://localhost:3001 을 넣는다.
# 배포 환경에서는 https://finditem-monitoring-server.vercel.app 을 넣는다.
# 값은 하나만 넣는다. 쉼표로 여러 주소를 나열하는 형식은 monitor-server의 MONITOR_WEB_ORIGINS에만 해당한다.
# 스킴(https://)을 반드시 포함하고 끝에 슬래시를 붙이지 않는다.
VITE_MONITOR_SERVER_URL=
